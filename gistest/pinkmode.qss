/* 设置全局背景颜色 */
QWidget {
    background-color: #ffebee; /* 淡粉色 */
}

/* QMenuBar 样式 */
QMenuBar {
    background-color: #ffebee; /* 淡粉色 */
    color: #d81b60; /* 粉红色 */
    font: bold 14px;
    font-family: YouYuan;
    border-radius: 8px; /* 圆角半径 */
    border: 1px solid #f48fb1; /* 边框粉色 */
    padding: 2px;
}

QMenuBar::item {
    background-color: #ffebee; /* 淡粉色 */
    padding: 4px 10px;
    color: #d81b60; /* 字体颜色粉红色 */
}

QMenuBar::item:selected {
    background-color: #f48fb1; /* 较浅的粉色 */
    color: #ffffff; /* 字体颜色白色 */
}

QMenuBar::item:pressed {
    background-color: #f06292; /* 更浅的粉色 */
    color: #ffffff; /* 字体颜色白色 */
}

/* QMenu 样式 */
QMenu {
    background-color: #ffebee; /* 淡粉色 */
    color: #d81b60; /* 粉红色 */
    border: 1px solid #f48fb1; /* 边框粉色 */
    border-radius: 6px; /* 圆角半径 */
}

QMenu::item {
    background-color: #ffebee; /* 淡粉色 */
    padding: 4px 10px;
    color: #d81b60; /* 字体颜色粉红色 */
}

QMenu::item:selected {
    background-color: #f48fb1; /* 较浅的粉色 */
    color: #ffffff; /* 字体颜色白色 */
}

QMenu::item:pressed {
    background-color: #f06292; /* 更浅的粉色 */
    color: #ffffff; /* 字体颜色白色 */
}

/* QToolBar 样式 */
QToolBar {
    background-color: #ffebee; /* 淡粉色 */
    border: 1px solid #f48fb1; /* 边框粉色 */
    padding: 2px;
    border-radius: 6px; /* 圆角半径 */
    box-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2); /* 添加阴影 */
    font-family: YouYuan;
    color: #d81b60; /* 粉红色 */
}

QToolBar QToolButton {
    background-color: #f48fb1; /* 较浅的粉色 */
    border: none;
    padding: 6px;
    margin: 6px;
    border-radius: 4px; /* 圆角半径 */
}

QToolBar QToolButton:checked {
    background-color: #f06292; /* 更浅的粉色 */
}

QToolBar QToolButton:hover {
    background-color: #f06292; /* 更浅的粉色 */
}

/* QDockWidget 样式 */
QDockWidget {
    titlebar-close-icon: url(./icon/icons8-close-96.png);
    titlebar-normal-icon: url(./icon/icons8-fullscreen-96.png);
    border: 1px solid #f48fb1; /* 边框粉色 */
    background-color: #ffebee; /* 淡粉色 */
    border-radius: 6px; /* 圆角半径 */
    box-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2); /* 添加阴影 */
    font-family: YouYuan;
    color: #d81b60; /* 粉红色 */
}

QDockWidget::title {
    background-color: #f48fb1; /* 较浅的粉色 */
    text-align: center;
    padding: 4px;
    border-top-left-radius: 6px; /* 标题栏左上角圆角 */
    border-top-right-radius: 6px; /* 标题栏右上角圆角 */
    font-family: YouYuan;
    color: #ffffff; /* 字体颜色白色 */
}

QDockWidget::close-button,
QDockWidget::float-button {
    border: none;
    background: transparent;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background: #f06292; /* 更浅的粉色 */
}

/* QTreeWidget 样式 */
QTreeWidget {
    background-color: #ffebee; /* 淡粉色 */
    color: #d81b60; /* 粉红色 */
    border: 1px solid #f48fb1; /* 边框粉色 */
    border-radius: 6px; /* 圆角半径 */
    font-family: YouYuan;
}

QTreeWidget::item {
    padding: 4px;
    border-bottom: 1px solid #f48fb1; /* 边框粉色 */
}

QTreeWidget::item:selected {
    background-color: #f48fb1; /* 较浅的粉色 */
    color: #ffffff; /* 字体颜色白色 */
}

QTreeWidget::item:hover {
    background-color: #f06292; /* 更浅的粉色 */
}

/* QListWidget 样式 */
QListWidget {
    padding: 4px;
    background-color: #ffebee; /* 淡粉色 */
    color: #d81b60; /* 粉红色 */
    border: 1px solid #f48fb1; /* 边框粉色 */
    border-radius: 6px; /* 圆角半径 */
    font-family: YouYuan;
}

QListWidget::item {
    border-bottom: 1px solid #f48fb1; /* 边框粉色 */
}

QListWidget::item:selected {
    background-color: #f48fb1; /* 较浅的粉色 */
    color: #ffffff; /* 字体颜色白色 */
}

QListWidget::item:hover {
    background-color: #f06292; /* 更浅的粉色 */
}

/* QComboBox 样式 */
QComboBox {
    background-color: #f48fb1; /* 较浅的粉色 */
    color: #d81b60; /* 粉红色 */
    border: 1px solid #f06292; /* 更浅的粉色 */
    padding: 4px;
    border-radius: 4px; /* 圆角半径 */
    font-family: YouYuan;
}

QComboBox QAbstractItemView {
    background-color: #f48fb1; /* 较浅的粉色 */
    color: #d81b60; /* 粉红色 */
    selection-background-color: #f06292; /* 更浅的粉色 */
    border: 1px solid #f06292; /* 更浅的粉色 */
    border-radius: 4px; /* 圆角半径 */
}

QComboBox::drop-down {
    border-left: 1px solid #f06292; /* 更浅的粉色 */
    icon-size: 20px;
}

QComboBox::down-arrow {
    image: url(./icon/icons8-chevron-down-12.png);
}

/* QLabel 样式 */
QLabel {
    color: #d81b60; /* 粉红色 */
    font: bold 14px;
    font-family: YouYuan;
}

/* QGraphicsView 样式 */
QGraphicsView {
    border: 1px solid #f48fb1; /* 边框粉色 */
    background-color: #ffebee; /* 淡粉色 */
    border-radius: 6px; /* 圆角半径 */
    box-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2); /* 添加阴影 */
    font-family: YouYuan;
    color: #d81b60; /* 粉红色 */
}

/* QStatusBar 样式 */
QStatusBar {
    background-color: #f48fb1; /* 较浅的粉色 */
    color: #d81b60; /* 粉红色 */
    font: bold 12px;
    border-radius: 6px; /* 圆角半径 */
    box-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2); /* 添加阴影 */
    font-family: YouYuan;
}

/* 设置缩放弹窗样式 */
QDialog {
    background-color: #ffebee; /* 淡粉色 */
    color: #d81b60; /* 粉红色 */
    border: 1px solid #f48fb1; /* 边框粉色 */
    font: 14px;
    border-radius: 8px; /* 圆角半径 */
    box-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2); /* 添加阴影 */
    font-family: YouYuan;
}

QDialog QLabel {
    color: #d81b60; /* 粉红色 */
    font: bold 14px;
}

QDialog QSlider {
    background-color: #f48fb1; /* 较浅的粉色 */
    color: #d81b60; /* 粉红色 */
    border: 1px solid #f06292; /* 更浅的粉色 */
}

QDialog QLineEdit {
    background-color: #f48fb1; /* 较浅的粉色 */
    color: #d81b60; /* 粉红色 */
    border: 1px solid #f06292; /* 更浅的粉色 */
    padding: 4px;
}

QDialog QPushButton {
    background-color: #f48fb1; /* 较浅的粉色 */
    color: #d81b60; /* 粉红色 */
    border: 1px solid #f06292; /* 更浅的粉色 */
    padding: 6px;
    font: bold 14px;
}

QDialog QPushButton:hover {
    background-color: #f06292; /* 更浅的粉色 */
}

/* 确认和取消按钮样式 */
QPushButton#mpConfirmButton, QPushButton#mpCancelButton {
    background-color: rgba(240, 98, 146, 128); /* 半透明粉色 */
    border: 1px solid #f06292; /* 更浅的粉色 */
    border-radius: 10px; /* 圆角半径 */
    color: white;
    padding: 10px;
}

QPushButton#mpConfirmButton:hover, QPushButton#mpCancelButton:hover {
    background-color: rgba(255, 138, 174, 128); /* 半透明更浅的粉色 */
}

QPushButton#mpConfirmButton:pressed, QPushButton#mpCancelButton:pressed {
    background-color: rgba(198, 40, 81, 128); /* 半透明深粉色 */
}
